include mixins
doctype html
html(lang="es", data-tema="claro")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="color-scheme", content="light dark")
    title= (titulo ? titulo + ' | ' : '') + 'Guía ISC'
    script(src="/js/theme-init.js")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap")
    link(rel="stylesheet", href="/css/style.css")
    link(rel="icon", href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%232457f5'/%3E%3Ctext x='50' y='70' font-size='58' font-family='sans-serif' font-weight='800' text-anchor='middle' fill='white'%3EI%3C/text%3E%3C/svg%3E")
  body(data-shell=usuario ? 'app' : 'auth', data-pagina=pagina)
    button#tema.tema-toggle(type="button", aria-label="Cambiar entre modo claro y oscuro", title="Modo claro / oscuro")
      svg.sol(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.9", stroke-linecap="round", aria-hidden="true")
        circle(cx="12", cy="12", r="4")
        path(d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4")
      svg.luna(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.9", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
        path(d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z")
    div(class=usuario ? 'app' : '')
      if usuario
        aside.barra
          a.marca(href="/")
            span.logo I
            span.marca-txt Guía ISC
          nav.nav
            each item in [['inicio', '/', 'Inicio', 'inicio'], ['materias', '/materias', 'Materias', 'materias'], ['habitos', '/habitos', 'Hábitos', 'habitos'], ['tiempo', '/tiempo', 'Organización', 'tiempo'], ['proyectos', '/proyectos', 'Proyectos', 'proyectos'], ['chat', '/chat', 'Chatbot', 'chat']]
              a.nav-item(href=item[1], data-pagina=item[0], class=(pagina === item[0] ? 'activo' : ''))
                +ico(item[3])
                span= item[2]
            if usuario.rol === 'admin'
              a.nav-item(href="/admin", data-pagina="admin", class=(pagina === 'admin' ? 'activo' : ''))
                +ico('admin')
                span Administración
          .perfil
            .avatar= usuario.nombre.charAt(0).toUpperCase()
            .perfil-dat
              strong= usuario.nombre.split(' ')[0]
              small= usuario.rol === 'admin' ? 'Administrador' : 'Estudiante'
            a.salir(href="/cerrar-sesion", data-hard, title="Cerrar sesión", aria-label="Cerrar sesión")
              +ico('salir')
      main#contenido(class=usuario ? '' : 'auth-main')
        block contenido
    #toasts(aria-live="polite")
    script(src="/js/app.js", defer)
